{
  "name": "pixel-explainer-workflow",
  "version": "0.1.0",
  "private": true,
  "description": "A reproducible pixel explainer workflow with a 25-second elevator example",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "preview": "hyperframes preview --no-open",
