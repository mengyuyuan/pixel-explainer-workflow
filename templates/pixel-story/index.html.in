<!doctype html><html lang="zh-CN"><head><meta charset="utf-8"><title>Pixel story</title><script src="vendor/gsap.min.js"></script><style>*{box-sizing:border-box}body{margin:0;background:#e7dfcc}#root{position:relative;width:{{width}}px;height:{{height}}px;overflow:hidden}canvas{position:absolute;inset:0}audio{display:none}</style></head><body><div id="root" data-composition-id="pixel-story" data-width="{{width}}" data-height="{{height}}" data-fps="{{fps}}" data-start="0" data-duration="{{duration}}"><canvas id="art" width="{{width}}" height="{{height}}"></canvas><audio id="story-audio" class="clip" data-start="0" data-duration="{{duration}}" data-track-index="3" src="build/mix.wav"></audio></div><script>window.__timelines={};</script><script src="atlas-data.js"></script><script src="film-data.js"></script><script src="performer-data.js"></script><script src="performers.js"></script><script src="scenes.js"></script><script src="engine.js"></script></body></html>
